# Cabeçalhos aplicados também em deploy manual (arrastar o zip).
# Em deploy conectado ao Git, o netlify.toml faz o mesmo papel.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Bundles com hash no nome podem ser eternos.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=604800, must-revalidate

# O HTML sempre revalida, para que uma publicação nova apareça na hora.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
