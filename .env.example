# ---------------------------------------------------------------------------
# HS CAR'S — variáveis opcionais
#
# O site já vem com os dados reais da loja em config/siteConfig.ts.
# Estas variáveis existem para sobrescrever qualquer valor sem tocar no
# código — útil para trocar número, links ou pixels direto no painel da
# Netlify (Site settings → Environment variables).
# ---------------------------------------------------------------------------

# Domínio próprio desta landing page. Se vazio, a Netlify injeta a URL do
# site publicado automaticamente (*.netlify.app).
NEXT_PUBLIC_SITE_URL=

# WhatsApp comercial — formato internacional, apenas dígitos.
# Atual: 5511947078010
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Site com o estoque de veículos. Atual: https://hscarsofc.com.br
NEXT_PUBLIC_STOCK_URL=

# Perfil público no Google. Atual: https://share.google/yZM35KG5WBsun5csP
NEXT_PUBLIC_GOOGLE_PROFILE_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Reputação. Atualize quando a nota ou a contagem mudarem no Google.
# Atual: 4,9 e 35
NEXT_PUBLIC_GOOGLE_RATING=
NEXT_PUBLIC_GOOGLE_REVIEWS_COUNT=

# Contato e geolocalização (entram no schema LocalBusiness/AutoDealer).
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_LATITUDE=
NEXT_PUBLIC_LONGITUDE=

# Fotografia editorial de fundo do hero (URL ou caminho em /public).
# Vazio = composição gráfica da marca.
NEXT_PUBLIC_HERO_IMAGE=

# Medição. Nada é carregado enquanto estiver vazio.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Espelho opcional dos leads para CRM/automação (recebe POST JSON).
NEXT_PUBLIC_LEAD_WEBHOOK_URL=
