# ---------------------------------------------------------------------------
# HS CAR'S — configuração da experiência
# Copie para .env.local e preencha. Tudo é opcional: campos vazios fazem a
# interface esconder o elemento correspondente em vez de mostrar dado falso.
# ---------------------------------------------------------------------------

# OBRIGATÓRIO para o WhatsApp funcionar.
# Formato internacional, apenas dígitos: 55 + DDD + número.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL canônica de produção (usada em canonical, sitemap, OpenGraph e schema).
NEXT_PUBLIC_SITE_URL=https://hscars.com.br

# Links externos. Vazio = o botão correspondente some ou cai em uma busca.
NEXT_PUBLIC_STOCK_URL=
NEXT_PUBLIC_GOOGLE_PROFILE_URL=
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# Reputação — preencher SOMENTE com os números reais do perfil do Google.
# Os dois precisam estar preenchidos para o bloco de nota aparecer.
NEXT_PUBLIC_GOOGLE_RATING=
NEXT_PUBLIC_GOOGLE_REVIEWS_COUNT=

# Contato e geolocalização (entram no schema LocalBusiness/AutoDealer).
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_LATITUDE=
NEXT_PUBLIC_LONGITUDE=

# Fotografia editorial de fundo do hero (URL ou caminho em /public).
# Vazio = composição gráfica da marca.
NEXT_PUBLIC_HERO_IMAGE=

# Medição. Nada é carregado enquanto estiver vazio.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Espelho opcional dos leads para CRM/automação (recebe POST JSON).
NEXT_PUBLIC_LEAD_WEBHOOK_URL=
